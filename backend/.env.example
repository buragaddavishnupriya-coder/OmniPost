# Database URL (Leave blank or omit for local SQLite: sqlite:///./omnipost.db)
# For Render PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./omnipost.db

# JWT Secret Key (Any random strong string)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# AI Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Allowed Frontend URL for CORS (e.g. GitHub Pages or Vercel URL)
FRONTEND_URL=https://buragaddavishnupriya-coder.github.io
